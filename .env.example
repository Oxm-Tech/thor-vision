TZ=America/Mexico_City
LOG_LEVEL=INFO

# LLM — Nemotron en DGX Spark
NEMOTRON_ENDPOINT=http://<IP_DGX>:8003/v1/chat/completions
NEMOTRON_MODEL=nemotron-omni

# Motion-gated scheduling
NEMOTRON_MIN_INTERVAL_S=30
NEMOTRON_MAX_INTERVAL_S=120
NEMOTRON_MOTION_THRESHOLD=0.04

# Retención
SNAPSHOT_PERIODIC_S=600
RETENTION_INTERVAL_S=3600
RETENTION_MAX_EVENTS=200000
RETENTION_MAX_SNAPSHOT_GB=50
RETENTION_MAX_AGE_DAYS=30
